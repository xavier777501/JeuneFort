# Jeune Fort Agrobusiness — Backend FastAPI

APP_NAME="Jeune Fort Agrobusiness API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000

# Base de données MySQL
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/jeune_fort_agrobusiness

# Sécurité / JWT
SECRET_KEY=change-moi-en-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (origins du frontend, séparées par des virgules)
CORS_ORIGINS=http://localhost:3000

# Kkiapay (passerelle de paiement)
KKIAPAY_API_KEY=
KKIAPAY_SECRET=
KKIAPAY_SANDBOX=true

# Notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Stockage images (Cloudinary / S3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
